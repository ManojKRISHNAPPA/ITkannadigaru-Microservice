pipeline {
    agent any

    environment {
        // Docker image tag - using build number
        TAG = "v${BUILD_NUMBER}"

        // JWT Secret (stored in Jenkins credentials)
        JWT_SECRET = credentials('jwt-secret')

        // Database credentials (stored in Jenkins credentials)
        DB_PASSWORD = credentials('mysql-root-password')

        // AWS/ECR Configuration (if using ECR)
        AWS_REGION = 'us-east-1'
        ECR_REGISTRY = 'YOUR_AWS_ACCOUNT.dkr.ecr.us-east-1.amazonaws.com'

        // Server SSH credentials (stored in Jenkins credentials)
        SERVER_HOST = 'YOUR_SERVER_IP'
        SERVER_USER = 'ubuntu'  // or your server user
    }

    stages {
        stage('Checkout') {
            steps {
                echo '📥 Checking out code from Git...'
                checkout scm
            }
        }

        stage('Build Docker Images') {
            steps {
                echo '🏗️  Building all Docker images...'
                script {
                    // Make build script executable
                    sh 'chmod +x build-all-images.sh'

                    // Build all images
                    sh """
                        export TAG=${TAG}
                        ./build-all-images.sh
                    """
                }
            }
        }

        stage('Test Images Locally') {
            steps {
                echo '🧪 Testing Docker images...'
                script {
                    // Basic tests - check if images exist
                    sh """
                        docker images | grep deployecho-backend:${TAG}
                        docker images | grep deployecho-frontend:${TAG}
                        docker images | grep instaclone-auth:${TAG}
                        docker images | grep instaclone-user:${TAG}
                    """
                }
            }
        }

        stage('Tag Images') {
            steps {
                echo '🏷️  Tagging images...'
                script {
                    // Tag with latest
                    sh """
                        docker tag deployecho-backend:${TAG} deployecho-backend:latest
                        docker tag deployecho-frontend:${TAG} deployecho-frontend:latest
                        docker tag instaclone-auth:${TAG} instaclone-auth:latest
                        docker tag instaclone-user:${TAG} instaclone-user:latest
                    """
                }
            }
        }

        // Optional: Push to Docker Registry (ECR/Docker Hub)
        stage('Push to Registry') {
            when {
                branch 'main'  // Only push from main branch
            }
            steps {
                echo '📤 Pushing images to registry...'
                script {
                    // Example for AWS ECR
                    sh """
                        # Login to ECR
                        aws ecr get-login-password --region ${AWS_REGION} | \
                          docker login --username AWS --password-stdin ${ECR_REGISTRY}

                        # Tag for ECR
                        docker tag deployecho-backend:${TAG} ${ECR_REGISTRY}/deployecho-backend:${TAG}
                        docker tag deployecho-frontend:${TAG} ${ECR_REGISTRY}/deployecho-frontend:${TAG}
                        docker tag instaclone-auth:${TAG} ${ECR_REGISTRY}/instaclone-auth:${TAG}
                        docker tag instaclone-user:${TAG} ${ECR_REGISTRY}/instaclone-user:${TAG}

                        # Push to ECR
                        docker push ${ECR_REGISTRY}/deployecho-backend:${TAG}
                        docker push ${ECR_REGISTRY}/deployecho-frontend:${TAG}
                        docker push ${ECR_REGISTRY}/instaclone-auth:${TAG}
                        docker push ${ECR_REGISTRY}/instaclone-user:${TAG}

                        # Push latest tags
                        docker tag deployecho-backend:${TAG} ${ECR_REGISTRY}/deployecho-backend:latest
                        docker tag deployecho-frontend:${TAG} ${ECR_REGISTRY}/deployecho-frontend:latest
                        docker tag instaclone-auth:${TAG} ${ECR_REGISTRY}/instaclone-auth:latest
                        docker tag instaclone-user:${TAG} ${ECR_REGISTRY}/instaclone-user:latest

                        docker push ${ECR_REGISTRY}/deployecho-backend:latest
                        docker push ${ECR_REGISTRY}/deployecho-frontend:latest
                        docker push ${ECR_REGISTRY}/instaclone-auth:latest
                        docker push ${ECR_REGISTRY}/instaclone-user:latest
                    """
                }
            }
        }

        stage('Deploy to Server') {
            when {
                branch 'main'  // Only deploy from main branch
            }
            steps {
                echo '🚀 Deploying to server...'
                script {
                    // SSH to server and deploy
                    sshagent(credentials: ['server-ssh-key']) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ${SERVER_USER}@${SERVER_HOST} << 'EOF'
                                # Navigate to application directory
                                cd /opt/itkannadigaru-microservice

                                # Pull latest code
                                git pull origin main

                                # Set environment variables
                                export TAG=${TAG}
                                export JWT_SECRET=${JWT_SECRET}
                                export DB_PASSWORD=${DB_PASSWORD}

                                # Pull images from registry (if using registry)
                                # docker-compose -f docker-compose-full.yml pull

                                # Or build locally (if not using registry)
                                chmod +x build-all-images.sh
                                ./build-all-images.sh

                                # Deploy with docker-compose
                                docker-compose -f docker-compose-full.yml up -d

                                # Wait for services to be healthy
                                sleep 30

                                # Check service status
                                docker-compose -f docker-compose-full.yml ps
EOF
                        """
                    }
                }
            }
        }

        stage('Smoke Tests') {
            when {
                branch 'main'
            }
            steps {
                echo '✅ Running smoke tests on deployed services...'
                script {
                    sshagent(credentials: ['server-ssh-key']) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ${SERVER_USER}@${SERVER_HOST} << 'EOF'
                                cd /opt/itkannadigaru-microservice

                                # Make test script executable
                                chmod +x test-all-services.sh

                                # Run tests
                                ./test-all-services.sh
EOF
                        """
                    }

                    // Or test from Jenkins server
                    sh """
                        # Test backend
                        curl -f http://${SERVER_HOST}:8080/health || exit 1
                        curl -f http://${SERVER_HOST}:8080/version || exit 1

                        # Test auth service
                        curl -f http://${SERVER_HOST}:3001/health || exit 1

                        # Test user service
                        curl -f http://${SERVER_HOST}:3002/health || exit 1

                        # Test nginx proxy
                        curl -f http://${SERVER_HOST}:8088/api/health || exit 1
                    """
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline completed successfully!'
            // Optional: Send notification (Slack, email, etc.)
            // slackSend(color: 'good', message: "Deployment successful: ${TAG}")
        }

        failure {
            echo '❌ Pipeline failed!'
            // Optional: Send notification
            // slackSend(color: 'danger', message: "Deployment failed: ${TAG}")

            // Rollback to previous version (optional)
            script {
                sshagent(credentials: ['server-ssh-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${SERVER_USER}@${SERVER_HOST} << 'EOF'
                            cd /opt/itkannadigaru-microservice
                            # Rollback to previous tag
                            export TAG=v\$((\$(echo ${TAG} | cut -d'v' -f2) - 1))
                            docker-compose -f docker-compose-full.yml up -d
EOF
                    """
                }
            }
        }

        always {
            echo '🧹 Cleaning up...'
            // Clean up old Docker images to save space
            sh '''
                # Remove dangling images
                docker image prune -f

                # Remove old images (keep last 5)
                docker images | grep deployecho-backend | tail -n +6 | awk '{print $3}' | xargs -r docker rmi -f || true
                docker images | grep deployecho-frontend | tail -n +6 | awk '{print $3}' | xargs -r docker rmi -f || true
                docker images | grep instaclone-auth | tail -n +6 | awk '{print $3}' | xargs -r docker rmi -f || true
                docker images | grep instaclone-user | tail -n +6 | awk '{print $3}' | xargs -r docker rmi -f || true
            '''
        }
    }
}
